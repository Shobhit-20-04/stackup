# ==========================================
# StackUp — Environment Variables Configuration
# ==========================================

# Supabase (Client & Server SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Database Connection Pooling (PgBouncer for serverless scale)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true

# AI / Anthropic Claude API (Used strictly server-side in later phases)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

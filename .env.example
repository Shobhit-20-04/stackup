# ==========================================
# StackUp — Environment Variables Configuration
# ==========================================

# Supabase (Client & Server SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Database Connection Pooling (PgBouncer for serverless scale)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true

# AI Assistant Configuration (StackUp Multi-Provider Architecture)
# Primary: 'gemini' | Alternative: 'anthropic' | 'auto' | Offline: 'local'
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash # Supported: gemini-3.8-flash, gemini-3.5-flash-lite, gemini-4-argon

# Anthropic Claude Fallback (Optional)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
